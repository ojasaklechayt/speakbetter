{
  "manifest_version": 3,
  "name": "SpeakBetter",
  "description": "A Chrome side panel coach for live meeting communication.",
  "version": "0.0.0",
  "permissions": ["storage", "tabs", "sidePanel"],
  "host_permissions": ["https://meet.google.com/*"],
  "action": {
    "default_title": "Open SpeakBetter"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html"
  }
}
